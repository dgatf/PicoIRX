 * Library for pin capture timer for RP2040
 */

.define PUBLIC IR_SEND_IRQ_NUM 1     // use 0 to 3

.define PUBLIC IR_SEND_COUNTER_CYCLES 28

.program ir_send

    pull block
    out y, 1
    out x, 31

period:
    jmp !y silent

mark:
    set pins, 1 [12]
    set pins, 0 [12]
    jmp x-- period
    jmp 0

silent:
    set pins, 0 [12]
    nop         [12]
    jmp x-- period
    jmp 0
