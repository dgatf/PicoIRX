.define PUBLIC IR_SEND_IRQ_NUM 1     // use 0 to 3

.define PUBLIC IR_SEND_COUNTER_CYCLES 3

.program ir_send  
    pull
loop:
    set pins, 1
    set pins, 0
    jmp loop